# HOUZQORA environment placeholders. No real secrets here.
# Copy this file to .env.local and fill in values only when the real services are set up.

# Database, later stage (Prisma + PostgreSQL)
# DATABASE_URL=

# Email, later stage (Resend, verified custom domain)
# RESEND_API_KEY=
# EMAIL_FROM=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (from your Supabase project dashboard, Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Admin panel login. These are server only, never prefixed with NEXT_PUBLIC_.
# The admin panel at /admin checks the login against these two values.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Supabase service role key, server only, for admin writes.
# From Supabase dashboard, Settings -> API, secret key. Keep it private.
SUPABASE_SERVICE_ROLE_KEY=

# Gateways, server only, never prefixed with NEXT_PUBLIC_.
# 1pay.cx (card) and Norpo (iDEAL) both pay out crypto to the wallet
# set in each gateway's merchant dashboard. The API URL, API key and
# webhook secret all come from that dashboard; there are no public
# docs. Until a gateway's key and API URL are both set, its checkout
# option stays hidden and its routes answer 503.
ONEPAY_API_URL=
ONEPAY_API_KEY=
ONEPAY_WEBHOOK_SECRET=
NORPO_API_URL=
NORPO_API_KEY=
NORPO_WEBHOOK_SECRET=
